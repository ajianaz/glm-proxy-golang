# Server
PORT=3000

# Upstream API key (used when per-key upstream_key is not set)
# Supports MASTER_KEY (new) with fallback to ZAI_API_KEY (legacy)
MASTER_KEY=your-upstream-api-key

# Admin API key for /admin/* endpoints
ADMIN_API_KEY=your-admin-api-key

# Default model (used when per-key model is not set and client doesn't specify)
DEFAULT_MODEL=glm-4.7

# Allowed models (comma-separated, empty = allow all)
# ALLOWED_MODELS=glm-4.7,glm-4.7-flash

# Upstream endpoints (LiteLLM proxy)
OPENAI_UPSTREAM=http://litellm:4000
ANTHROPIC_UPSTREAM=http://litellm:4000

# Storage
DB_PATH=./proxy.db

# Data file (legacy JSON, ignored when DB_PATH is set)
DATA_FILE=data/apikeys.json
